# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values before running:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED ────────────────────────────────────────────────────────────────────

# Random secret for JWT signing. Generate one with:
#   openssl rand -hex 32
SECRET_KEY=replace-me-with-a-random-64-char-string

# Postgres password (used internally between containers)
DB_PASSWORD=saas_manager

# ─── Okta integration ────────────────────────────────────────────────────────
# Get your API token from: Okta Admin → Security → API → Tokens
OKTA_DOMAIN=yourorg.okta.com
OKTA_API_TOKEN=

# ─── Azure AD integration ────────────────────────────────────────────────────
# Create an App Registration in Azure Portal with these permissions:
#   Application.Read.All, User.Read.All (application permissions)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ─── Slack notifications ─────────────────────────────────────────────────────
# Create an incoming webhook at: api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ─── Email notifications ─────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=saas-manager@yourcompany.com

# ─── File storage (contract PDFs) ────────────────────────────────────────────
# S3 bucket for storing uploaded contract PDFs.
# Leave blank to skip file uploads for now.
S3_BUCKET=saas-manager-contracts
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# If you use MinIO or another S3-compatible store, set this:
S3_ENDPOINT_URL=
