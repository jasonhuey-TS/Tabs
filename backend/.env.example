APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string

DATABASE_URL=postgresql+asyncpg://saas_manager:saas_manager@localhost:5432/saas_manager
REDIS_URL=redis://localhost:6379/0

# Okta
OKTA_DOMAIN=yourorg.okta.com
OKTA_API_TOKEN=your_okta_api_token_here

# Azure AD
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# S3 (leave S3_ENDPOINT_URL empty for AWS, set for MinIO)
S3_BUCKET=saas-manager-contracts
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SMTP_HOST=smtp.yourcompany.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=saas-manager@yourcompany.com
